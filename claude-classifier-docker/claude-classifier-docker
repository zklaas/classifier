def cmd_selftest() -> int:
    ensure_docker()
    reap_stale()
    build_images(False)
    ws = CACHE / "selftest-ws"
    shutil.rmtree(ws, ignore_errors=True)
    (ws / "w").mkdir(parents=True)
    (ws / ".env").write_text("SECRET=do-not-show\n")
    (ws / "README").write_text("claude-classifier-docker self-test workspace\n")
    # a host service on every address, which the container must not reach
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("0.0.0.0", 0))
    srv.listen(5)
    port = srv.getsockname()[1]
    addrs = subprocess.run(["hostname", "-I"], text=True, capture_output=True).stdout.split()
    addrs = list(dict.fromkeys([a for a in addrs if ":" not in a] + ["172.17.0.1"]))
    targets = " ".join(f"{a}:{port}" for a in addrs)
    ns = argparse.Namespace(workspace=str(ws), write=["w"], allow_host=[], prompt_file=None,
                            brief_file=None, settings_file=None, model=None, gui=False,
                            shell=False, upgrade=False)
    pending_before = {p.name for p in pending_sets()}
    results = []
    own_runs = []                        # the self-test's own run ids (real sessions may be open)

    def run_probe(script):
        for f in ("allow-now", "allowed"):             # a fresh signal for each session
            (ws / "w" / f).unlink(missing_ok=True)
        run_id, meta = prepare(ns, command=["bash", "-c", script], tty=False)
        own_runs.append(run_id)
        m = read_json(RUNS / run_id / "meta.json")
        m["selftest"] = True
        write_json(RUNS / run_id / "meta.json", m)
        a = read_json(RUNS / run_id / "docker-args.json")
        a[a.index("--network"):a.index("--network")] = ["-e", f"CD_HOST_TARGETS={targets}"]
        write_json(RUNS / run_id / "docker-args.json", a)
        (RUNS / run_id / "runner.pid").write_text(f"{os.getpid()}\n")
        stop = threading.Event()

        def watcher():                              # plays the person running --allow
            while not stop.is_set():
                if (ws / "w" / "allow-now").exists():
                    cmd_allow("pypi.org", keep=False, only=run_id)   # never a real session
                    (ws / "w" / "allowed").touch()
                    return
                time.sleep(0.3)
        t = threading.Thread(target=watcher, daemon=True)
        t.start()
        out = subprocess.run(["docker", *a], text=True, capture_output=True, timeout=600).stdout
        stop.set()
        log = (CACHE / "proxy-logs" / run_id / "access.log")
        acc = log.read_text(errors="replace") if log.is_file() else ""
        finish_run(run_id, quiet=True)
        return out, acc

    try:
        say("claude-classifier-docker self-test: first session…")
        out, acc = run_probe(PROBE)
        results += out.splitlines()
        results.append(("PASS" if "TCP_TUNNEL" in acc and "api.anthropic.com" in acc else "FAIL")
                       + " V10 the proxy log records the allowed tunnels")
        results.append(("PASS" if "TCP_DENIED" in acc and "pypi.org" in acc else "FAIL")
                       + " V10 the proxy log records the refusals")
        if "pypi.org" in [x.lower() for x in list_lines(ALLOWED_HOSTS)]:
            results.append("FAIL V16 --allow without --keep saved the host")
        new_sets = [p for p in pending_sets() if p.name not in pending_before]
        results.append(("PASS" if new_sets else "FAIL")
                       + " V19 the session's memory note was held as a pending set")
        say("claude-classifier-docker self-test: second session…")
        out2, _ = run_probe(PROBE2)
        results += out2.splitlines()
        for p in pending_sets():
            if p.name not in pending_before:
                shutil.rmtree(p, ignore_errors=True)       # the self-test's own note
        leftovers = [c for rid in own_runs for c in
                     docker("ps", "-a", "--filter", f"label={LABEL}={rid}", "-q").stdout.split()]
        nets = [n for rid in own_runs for n in
                docker("network", "ls", "--filter", f"label={LABEL}={rid}", "-q").stdout.split()]
        leftovers += [r for r in own_runs if (RUNS / r).exists()]
        live_runs = [r for r in RUNS.iterdir()] if RUNS.is_dir() else []
        results.append(("PASS" if not leftovers and not nets else "FAIL")
                       + " V11 the test's own containers, networks and run folders are gone"
                       + (f" ({len(leftovers)} containers, {len(nets)} networks)" if leftovers or nets else ""))
        # refusals
        for bad_ws in (str(HOME), "/mnt/c/Users", "/"):
            try:
                resolve_workspace(bad_ws)
                results.append(f"FAIL V4 {bad_ws} was accepted as a launch folder")
            except Refused:
                results.append(f"PASS V4 {bad_ws} refused as a launch folder")
        (ws / "link").symlink_to(ws / "w")
        try:
            resolve_writes(ws.resolve(), ["link"])
            results.append("FAIL V4 a symlinked --write folder was accepted")
        except Refused:
            results.append("PASS V4 a symlinked --write folder is refused")
        del live_runs
    finally:
        srv.close()
        shutil.rmtree(ws, ignore_errors=True)
    passed = sum(1 for r in results if r.startswith("PASS"))
    failed = [r for r in results if r.startswith("FAIL")]
    say("")
    for r in results:
        if r.startswith(("PASS", "FAIL")):
            say("  " + r)
    say(f"\nclaude-classifier-docker self-test: {passed} passed, {len(failed)} failed.")
    say("Not automatic (check by hand): V9 policy in /status and no auto/bypass mode; "
        "V12 WebSearch/WebFetch in a session; the OSC 52 clipboard test; V17/V18; the ZIS buttons.")
    return 1 if failed else 0


# ─────────────────────────────── main ──────────────────────────────────────
def parse(argv):
    p = argparse.ArgumentParser(prog="claude-classifier-docker", add_help=False,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("workspace", nargs="?")
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("--gui", action="store_true")
    p.add_argument("--shell", action="store_true")
    p.add_argument("--upgrade", "--rebuild", dest="upgrade", action="store_true")
    p.add_argument("--models", action="store_true")
    p.add_argument("--default-model")
    p.add_argument("--model")
    p.add_argument("--prompt-file")
    p.add_argument("--brief-file")
    p.add_argument("--settings-file")
    p.add_argument("--write", action="append")
    p.add_argument("--allow-host", action="append")
    p.add_argument("--allow")
    p.add_argument("--keep", action="store_true")
    p.add_argument("--continue", dest="cont", action="store_true")
    p.add_argument("--resume", nargs="?", const="")
    p.add_argument("--memory", action="store_true")
    p.add_argument("--policy", nargs="?", const="show")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--_run", dest="run_id", help=argparse.SUPPRESS)
    p.add_argument("--_window", dest="window_run_id", help=argparse.SUPPRESS)
    return p.parse_args(argv)


def main(argv=None) -> int:
    args = parse(sys.argv[1:] if argv is None else argv)
    if args.help:
        say(__doc__.strip())
        return 0
    try:
        if args.run_id:
            return run_session(args.run_id)
        if args.window_run_id:
            return run_window(args.window_run_id)
        if args.default_model:
            m = resolve_model(args.default_model)
            if not m:
                say(f"claude-classifier-docker: not a model name or a number from the list: {args.default_model}", err=True)
                return 1
            save_default(m)
            return 0
        if args.models:
            return cmd_models()
        if args.policy:
            return cmd_policy(args.policy)
        if args.memory:
            return cmd_memory()
        if args.allow:
            return cmd_allow(args.allow, args.keep)
        if args.selftest:
            return cmd_selftest()
        if args.upgrade and not (args.workspace or args.gui or args.shell):
            ensure_docker()
            reap_stale()
            build_images(True)
            return 0
        if args.cont or args.resume is not None:
            return cmd_resume(args)
        return cmd_launch(args)
    except Refused as exc:
        say(f"claude-classifier-docker: {exc}", err=True)
        if getattr(args, "gui", False):
            show_error_window(str(exc))
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())

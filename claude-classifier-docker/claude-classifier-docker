XTERM_CLASS = "classifier"


def xterm_argv(title, command):
    # Linux version: -class (not just -name) so GNOME Shell's WM_CLASS match hits
    # classifier.desktop (and the ZIS icon) instead of the stock
    # debian-xterm.desktop. -class renames the resource class, so every XTerm*
    # resource is also given under the new class or the lockdown would not apply.
    argv = ["xterm", "-name", XTERM_CLASS, "-class", XTERM_CLASS, "-title", title]
    for r in XTERM_RESOURCES:
        argv += ["-xrm", r, "-xrm", XTERM_CLASS + r[len("XTerm"):]]
    return argv + ["-u8", "-fa", "DejaVu Sans Mono", "-fs", "11", "-bg", "#1e1e1e",
                   "-fg", "#d4d4d4", "-geometry", "120x36", "-e", *command]


def show_error_window(msg):
    """Under --gui with nobody watching the output (ZIS), a refusal must be seen."""
    if sys.stderr.isatty() or not os.environ.get("DISPLAY") or not shutil.which("xterm"):
        return
    script = 'printf "%s\\n\\n" "$1"; printf "Press Enter to close. "; read x'
    subprocess.Popen(xterm_argv("claude-classifier-docker — could not start",
                                ["sh", "-c", script, "sh", "claude-classifier-docker could not start:\n\n" + msg]),
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)



def has_pyqt6() -> bool:
    import importlib.util
    return importlib.util.find_spec("PyQt6") is not None


def refused_counts(run_id) -> list[tuple[str, int]]:
    counts = {}
    try:
        text = (CACHE / "proxy-logs" / run_id / "access.log").read_text(errors="replace")
    except OSError:
        return []
    for line in text.splitlines():
        if "TCP_DENIED" in line:
            target = line.split()[-1]
            host = target.rsplit(":", 1)[0] if ":" in target else target
            counts[host] = counts.get(host, 0) + 1
    return sorted(counts.items())


def remove_saved_host(host) -> bool:
    """Take a host off the saved list; running sessions lose it at once."""
    h = host.lower()
    try:
        lines = ALLOWED_HOSTS.read_text(encoding="utf-8").splitlines()
    except OSError:
        return False
    kept = [ln for ln in lines if ln.strip().lower() != h]
    if len(kept) == len(lines):
        return False
    ALLOWED_HOSTS.write_text("\n".join(kept) + "\n", encoding="utf-8")
    for run in (RUNS.iterdir() if RUNS.is_dir() else []):
        try:
            pid = int((run / "runner.pid").read_text().strip())
        except (OSError, ValueError):
            continue
        if pid_alive(pid) and h not in list_lines(run / "proxy" / "extra-hosts.txt"):
            hosts_file(run)
            reload_proxy(run.name)
    return True


def run_window(run_id) -> int:
    # CLAUDE_DOCKER_WINDOW_SHOTS=DIR renders the window and every dialog to PNGs
    # off-screen and exits: a visual check that opens nothing on the desktop.
    shots = os.environ.get("CLAUDE_DOCKER_WINDOW_SHOTS")
    os.environ["QT_QPA_PLATFORM"] = "offscreen" if shots else "xcb"
    import ctypes
    from PyQt6.QtCore import QEvent, Qt, QTimer
    from PyQt6.QtWidgets import (QApplication, QCheckBox, QDialog, QDialogButtonBox,
                                 QHBoxLayout, QLabel, QLineEdit, QListWidget,
                                 QListWidgetItem, QMainWindow, QMessageBox, QPushButton,
                                 QTabWidget, QTextBrowser, QVBoxLayout, QWidget)

    me = os.path.abspath(__file__)
    run = RUNS / run_id
    meta = read_json(run / "meta.json", {}) or {}

    # Xlib, for the three things Qt cannot do to another program's window:
    # find it, size it, and give it the keyboard.
    x11 = ctypes.cdll.LoadLibrary("libX11.so.6")
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XQueryTree.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
                               ctypes.POINTER(ctypes.c_ulong),
                               ctypes.POINTER(ctypes.POINTER(ctypes.c_ulong)),
                               ctypes.POINTER(ctypes.c_uint)]
    x11.XMoveResizeWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int,
                                      ctypes.c_int, ctypes.c_uint, ctypes.c_uint]
    x11.XSetInputFocus.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
    x11.XGetInputFocus.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong),
                                   ctypes.POINTER(ctypes.c_int)]
    x11.XFlush.argtypes = [ctypes.c_void_p]
    x11.XFree.argtypes = [ctypes.c_void_p]
    x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XKeysymToKeycode.restype = ctypes.c_ubyte
    x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
    x11.XStringToKeysym.restype = ctypes.c_ulong
    try:
        xtst = ctypes.cdll.LoadLibrary("libXtst.so.6")
        xtst.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int,
                                           ctypes.c_ulong]
    except OSError:
        xtst = None
    handler_t = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
    ignore_errors = handler_t(lambda d, e: 0)     # a vanished xterm must not kill us
    x11.XSetErrorHandler.argtypes = [handler_t]
    x11.XSetErrorHandler(ignore_errors)
    dpy = x11.XOpenDisplay(None)

    def x_children(win):
        root, parent = ctypes.c_ulong(), ctypes.c_ulong()
        kids, n = ctypes.POINTER(ctypes.c_ulong)(), ctypes.c_uint()
        if not dpy or not x11.XQueryTree(dpy, win, ctypes.byref(root), ctypes.byref(parent),
                                         ctypes.byref(kids), ctypes.byref(n)):
            return []
        out = [kids[i] for i in range(n.value)]
        if kids:
            x11.XFree(kids)
        return out

    def x_focus():
        w, r = ctypes.c_ulong(), ctypes.c_int()
        x11.XGetInputFocus(dpy, ctypes.byref(w), ctypes.byref(r))
        return w.value

    def press(*names):
        """Real key presses (XTest) into whatever has the X focus."""
        codes = [x11.XKeysymToKeycode(dpy, x11.XStringToKeysym(n.encode())) for n in names]
        for c in codes:
            xtst.XTestFakeKeyEvent(dpy, c, 1, 0)
        for c in reversed(codes):
            xtst.XTestFakeKeyEvent(dpy, c, 0, 0)
        x11.XFlush(dpy)

    def plain(text):
        lab = QLabel(text)
        lab.setTextFormat(Qt.TextFormat.PlainText)
        lab.setWordWrap(True)
        return lab

    def open_terminal(title, argv):
        """A separate terminal for a flow that asks questions (policy edit, memory)."""
        wrapped = ["bash", "-c", '"$@"; echo; read -r -p "Press Enter to close. " _', "x", *argv]
        subprocess.Popen(xterm_argv(title, wrapped), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)

    class Host(QWidget):
        def __init__(self):
            super().__init__()
            self.setAttribute(Qt.WidgetAttribute.WA_NativeWindow)
            self.setAttribute(Qt.WidgetAttribute.WA_DontCreateNativeAncestors)
            self.setStyleSheet("background:#1e1e1e")
            self.term = None

        def target(self):
            inner = x_children(self.term) if self.term else []
            return inner[0] if inner else self.term

        def resizeEvent(self, e):
            super().resizeEvent(e)
            self.fit()

        def fit(self):
            if self.term and dpy:
                r = self.devicePixelRatioF()
                x11.XMoveResizeWindow(dpy, self.term, 0, 0, max(1, int(self.width() * r)),
                                      max(1, int(self.height() * r)))
                x11.XFlush(dpy)

        def focus_term(self):
            t = self.target()
            if t and dpy:
                x11.XSetInputFocus(dpy, t, 2, 0)            # RevertToParent
                x11.XFlush(dpy)

    class AllowDialog(QDialog):
        def __init__(self, parent, host=""):
            super().__init__(parent)
            self.setWindowTitle("Allow a host")
            self.setMinimumWidth(460)
            lay = QVBoxLayout(self)
            lay.addWidget(plain("Host name to allow (exact, e.g. www.tides.gc.ca). "
                                "Every allowed host is a place data could be sent to."))
            self.edit = QLineEdit(host)
            lay.addWidget(self.edit)
            self.keep = QCheckBox("Keep it for future sessions too")
            lay.addWidget(self.keep)
            bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok
                                  | QDialogButtonBox.StandardButton.Cancel)
            bb.accepted.connect(self.accept)
            bb.rejected.connect(self.reject)
            lay.addWidget(bb)

    def do_allow(parent, host, keep):
        h = host.strip().lower()
        if not HOST_RE.match(h):
            QMessageBox.warning(parent, "Not a host name",
                                "That is not a host name (e.g. www.tides.gc.ca).")
            return False
        cmd_allow(h, keep)
        QMessageBox.information(
            parent, "Allowed",
            f"{h} is allowed in this session now"
            + (" and saved for future sessions." if keep else ".")
            + "\n\nTell Claude to try again.")
        return True

    class Review(QDialog):
        def __init__(self, parent):
            super().__init__(parent)
            self.setWindowTitle("Review — claude-classifier-docker")
            _fit(self, 640, 460)
            lay = QVBoxLayout(self)
            self.tabs = QTabWidget()
            lay.addWidget(self.tabs)
            self.tabs.addTab(self._hosts_tab(), "Allowed hosts")
            self.tabs.addTab(self._refused_tab(), "Refused so far")
            self.tabs.addTab(self._policy_tab(), "Policy")
            self.tabs.addTab(self._memory_tab(), "Memory")
            bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
            bb.rejected.connect(self.reject)
            lay.addWidget(bb)
            self.timer = QTimer(self, interval=2000, timeout=self.refresh)
            self.timer.start()
            self.refresh()

        # allowed hosts
        def _hosts_tab(self):
            w = QWidget(); v = QVBoxLayout(w)
            v.addWidget(plain("Hosts this session can reach. The Anthropic hosts are always "
                              "allowed: Claude Code needs them to work and to sign in."))
            self.hosts = QListWidget(); v.addWidget(self.hosts)
            row = QHBoxLayout()
            for text, fn in (("Allow a host…", self._add), ("Remove from the saved list", self._remove),
                             ("Keep for future sessions", self._keep)):
                b = QPushButton(text); b.clicked.connect(fn); row.addWidget(b)
            v.addLayout(row)
            return w

        def _fill_hosts(self):
            cur = self.hosts.currentItem().data(Qt.ItemDataRole.UserRole) if self.hosts.currentItem() else None
            self.hosts.clear()
            extras = list_lines(run / "proxy" / "extra-hosts.txt")
            rows = [(h, "always (Claude Code)", "fixed") for h in ANTHROPIC_HOSTS]
            rows += [(h.lower(), "saved", "saved") for h in list_lines(ALLOWED_HOSTS)]
            rows += [(h, "this session only", "session") for h in extras
                     if h not in [r[0] for r in rows]]
            for h, what, kind in rows:
                it = QListWidgetItem(f"{h}    — {what}")
                it.setData(Qt.ItemDataRole.UserRole, (h, kind))
                if kind == "fixed":
                    it.setFlags(Qt.ItemFlag.NoItemFlags)
                self.hosts.addItem(it)
                if cur and cur[0] == h:
                    self.hosts.setCurrentItem(it)

        def _selected(self, kind):
            it = self.hosts.currentItem()
            d = it.data(Qt.ItemDataRole.UserRole) if it else None
            if not d or d[1] != kind:
                QMessageBox.information(self, "Choose a host",
                                        f"Select a {'saved' if kind == 'saved' else 'this-session'} host first.")
                return None
            return d[0]

        def _add(self):
            dlg = AllowDialog(self)
            if dlg.exec():
                do_allow(self, dlg.edit.text(), dlg.keep.isChecked())
                self.refresh()

        def _remove(self):
            h = self._selected("saved")
            if h and QMessageBox.question(
                    self, "Remove host",
                    f"Remove {h} from the saved list?\n\nRunning sessions lose it at once, "
                    "and future sessions won't have it.") == QMessageBox.StandardButton.Yes:
                remove_saved_host(h)
                self.refresh()

        def _keep(self):
            h = self._selected("session")
            if h:
                cmd_allow(h, keep=True)
                self.refresh()

        # refused
        def _refused_tab(self):
            w = QWidget(); v = QVBoxLayout(w)
            v.addWidget(plain("Hosts the proxy refused in this session. These names come from "
                              "requests made INSIDE the container, so allow only hosts you "
                              "recognise and want the session to reach."))
            self.refused = QListWidget(); v.addWidget(self.refused)
            row = QHBoxLayout()
            b1 = QPushButton("Allow for this session"); b1.clicked.connect(lambda: self._allow_refused(False))
            b2 = QPushButton("Allow and keep"); b2.clicked.connect(lambda: self._allow_refused(True))
            row.addWidget(b1); row.addWidget(b2); v.addLayout(row)
            return w

        def _fill_refused(self):
            cur = self.refused.currentItem().data(Qt.ItemDataRole.UserRole) if self.refused.currentItem() else None
            allowed = set(ANTHROPIC_HOSTS) | {h.lower() for h in list_lines(ALLOWED_HOSTS)} \
                | set(list_lines(run / "proxy" / "extra-hosts.txt"))
            self.refused.clear()
            for h, n in refused_counts(run_id):
                note = "  (allowed since)" if h.lower() in allowed else ""
                if h in CLAUDE_BACKGROUND_HOSTS:
                    note += "  — Claude Code's own background check; normally leave blocked"
                it = QListWidgetItem(f"{h}    — refused {n} time{'s' if n != 1 else ''}{note}")
                it.setData(Qt.ItemDataRole.UserRole, h)
                self.refused.addItem(it)
                if cur == h:
                    self.refused.setCurrentItem(it)
            if not self.refused.count():
                it = QListWidgetItem("(nothing refused so far)")
                it.setFlags(Qt.ItemFlag.NoItemFlags)
                self.refused.addItem(it)

        def _allow_refused(self, keep):
            it = self.refused.currentItem()
            h = it.data(Qt.ItemDataRole.UserRole) if it else None
            if not h:
                QMessageBox.information(self, "Choose a host", "Select a refused host first.")
                return
            do_allow(self, h, keep)
            self.refresh()

        # policy
        def _policy_tab(self):
            w = QWidget(); v = QVBoxLayout(w)
            v.addWidget(plain(f"The policy no session can change ({POLICY}):"))
            self.policy = plain("")
            v.addWidget(self.policy)
            v.addStretch(1)
            b = QPushButton("Edit the policy…")
            b.clicked.connect(lambda: open_terminal("claude-classifier-docker — policy", [sys.executable, me, "--policy", "edit"]))
            v.addWidget(b)
            v.addWidget(plain("An edit is checked: anything it loosens is listed and must be "
                              "confirmed. It applies from the next launch."))
            return w

        def _fill_policy(self):
            data = read_json(POLICY)
            if not isinstance(data, dict):
                self.policy.setText("The policy file is missing or not valid JSON.")
                return
            text = "\n".join(policy_describe(data))
            accepted = (list_lines(POLICY_ACCEPTED) or [""])[0]
            if POLICY.is_file() and accepted and accepted != sha256(POLICY):
                text += ("\n\nThe file changed since it was last accepted; launches are "
                         "refused until it is reviewed with Edit the policy….")
            self.policy.setText(text)

        # memory
        def _memory_tab(self):
            w = QWidget(); v = QVBoxLayout(w)
            v.addWidget(plain("Memory changes Docker sessions have made, waiting for you. Later "
                              "sessions see a change only once you approve it. This session's "
                              "own changes appear here after it ends."))
            self.memory = QListWidget(); v.addWidget(self.memory)
            b = QPushButton("Review memory changes…")
            b.clicked.connect(lambda: open_terminal("claude-classifier-docker — memory", [sys.executable, me, "--memory"]))
            v.addWidget(b)
            return w

        def _fill_memory(self):
            self.memory.clear()
            for s in pending_sets():
                m = read_json(s / "meta.json", {}) or {}
                n = len(read_json(s / "base.json", {}) or {}) + len(read_json(s / "deleted.json", []) or [])
                topic = re.search(r"/topics/([^/]+)/", m.get("brief") or "")
                self.memory.addItem(QListWidgetItem(
                    f"{m.get('created', s.name)} — {n} file(s)"
                    + (f", topic {topic.group(1)}" if topic else "")))
            if not self.memory.count():
                it = QListWidgetItem("(nothing waiting)")
                it.setFlags(Qt.ItemFlag.NoItemFlags)
                self.memory.addItem(it)

        def refresh(self):
            self._fill_hosts(); self._fill_refused(); self._fill_policy(); self._fill_memory()

    class Win(QMainWindow):
        def __init__(self):
            super().__init__()
            self.setWindowTitle(TITLE)
            self.host = Host()
            self.setCentralWidget(self.host)
            _fit(self, 1000, 660)
            self.proc = None
            ms = self.menuBar().addMenu("&Session")
            ms.addAction("Paste from the clipboard", self.paste)
            ms.addSeparator()
            ms.addAction("Allow a host…", self.allow_host)
            ms.addSeparator()
            ms.addAction("End the session", self.close)
            mr = self.menuBar().addMenu("&Review")
            mr.addAction("Review hosts, policy and memory…", self.review)
            mh = self.menuBar().addMenu("&Help")
            mh.addAction("Help — this window and the commands…", self.help)
            mh.addAction("About this session…", self.about)
            self.status = QLabel()
            self.status.setTextFormat(Qt.TextFormat.PlainText)
            self.statusBar().addWidget(self.status, 1)
            self.tick = QTimer(self, interval=2000, timeout=self.update_status)
            self.last_refused = 0

        def showEvent(self, e):
            super().showEvent(e)
            if self.proc is None and not shots and not getattr(self, '_starting', False):
                self._starting = True
                QTimer.singleShot(150, self.start)

        def start(self):
            argv = ["xterm", "-into", str(int(self.host.winId()))]
            for r in XTERM_RESOURCES:
                argv += ["-xrm", r]
            argv += ["-u8", "-fa", "DejaVu Sans Mono", "-fs", "11", "-bg", "#1e1e1e",
                     "-fg", "#d4d4d4", "-e", sys.executable, me, "--_run", run_id]
            self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.finder = QTimer(self, interval=100, timeout=self.find_term)
            self.finder.start()
            self.watch = QTimer(self, interval=500, timeout=self.check_exit)
            self.watch.start()
            self.tick.start()
            self.update_status()

        def find_term(self):
            kids = x_children(int(self.host.winId()))
            if kids:
                self.host.term = kids[0]
                self.finder.stop()
                self.host.fit()
                self.host.focus_term()
                self.keeper = QTimer(self, interval=250, timeout=self.keep_focus)
                self.keeper.start()

        def keep_focus(self):
            """While this window is active and no menu or dialog is open, the
            keyboard belongs to the terminal (WSLg hands it to no window otherwise)."""
            if (self.isActiveWindow() and QApplication.activeModalWidget() is None
                    and QApplication.activePopupWidget() is None
                    and x_focus() != self.host.target()):
                self.host.focus_term()

        def check_exit(self):
            if self.proc and self.proc.poll() is not None:
                self.close()

        def update_status(self):
            ws = Path(meta.get("workspace") or "")
            writes = [Path(w).relative_to(ws).as_posix() if ws and Path(w).is_relative_to(ws) else w
                      for w in meta.get("writes") or []]
            n = sum(c for h, c in refused_counts(run_id) if h not in CLAUDE_BACKGROUND_HOSTS)
            parts = ["paste: Ctrl+Shift+V or right-click", f"{ws.name or ws} (read-only)",
                     "writable: " + (", ".join(writes) if writes else "nothing"),
                     f"refused so far: {n}" + (" — see Review" if n else "")]
            self.status.setText("   ·   ".join(parts))

        def paste(self):
            """What Ctrl+Shift+V does, for anyone who would rather not remember it."""
            if not (xtst and dpy and self.host.target()):
                QMessageBox.information(self, "Paste",
                                        "Click in the terminal and press Ctrl+Shift+V (or right-click).")
                return
            def go():
                self.host.focus_term()
                x11.XFlush(dpy)
                QTimer.singleShot(80, lambda: press("Control_L", "Shift_L", "v"))
            QTimer.singleShot(120, go)          # after the menu has closed

        def allow_host(self):
            dlg = AllowDialog(self)
            if dlg.exec():
                do_allow(self, dlg.edit.text(), dlg.keep.isChecked())
            self.host.focus_term()

        def review(self):
            Review(self).exec()
            self.host.focus_term()

        def help(self):
            self.help_dialog().exec()
            self.host.focus_term()

        def help_dialog(self):
            d = QDialog(self)
            d.setWindowTitle("Help — claude-classifier-docker")
            _fit(d, 720, 620)
            v = QVBoxLayout(d)
            tb = QTextBrowser()
            tb.setOpenLinks(False)
            tb.setHtml(HELP_HTML)
            v.addWidget(tb)
            bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
            bb.rejected.connect(d.reject)
            v.addWidget(bb)
            return d

        def about(self):
            self.about_box().exec()
            self.host.focus_term()

        def about_box(self):
            ws = meta.get("workspace") or "?"
            lines = [f"Launch folder (read-only at /workspace):\n  {ws}",
                     "Writable:\n  " + ("\n  ".join(meta.get("writes") or []) or "nothing"),
                     "Hidden from Claude (appear empty):\n  "
                     + ("\n  ".join(m for m, _ in meta.get("masks") or []) or "nothing"),
                     "Also allowed for this launch:\n  " + (", ".join(meta.get("allow_hosts") or []) or "nothing"),
                     f"Model: {meta.get('model')} ({meta.get('model_from')})"]
            if meta.get("resume_of"):
                lines.append(f"Resumed session: {meta['resume_of']}")
            if meta.get("brief_src"):
                lines.append(f"Brief: {meta['brief_src']}")
            box = QMessageBox(self)
            box.setWindowTitle("About this session")
            box.setTextFormat(Qt.TextFormat.PlainText)
            box.setText("\n\n".join(lines))
            return box

        def event(self, e):
            if e.type() == QEvent.Type.WindowActivate:
                QTimer.singleShot(0, self.host.focus_term)
            return super().event(e)

        def closeEvent(self, e):
            # ending the xterm ends the session: its runner gets HUP and cleans up
            if self.proc and self.proc.poll() is None:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
            super().closeEvent(e)

    # Linux version: GNOME Shell takes a window's dash/taskbar/Alt-Tab icon ONLY
    # from the installed .desktop its WM_CLASS / app id matches (setWindowIcon is
    # ignored there), so name this window classifier before Qt starts;
    # zis/make-desktop-files.py installs classifier.desktop + its icon.
    os.environ.setdefault("RESOURCE_NAME", "classifier")
    app = QApplication([sys.argv[0]])
    app.setApplicationName("claude-classifier-docker")
    app.setDesktopFileName("classifier")
    from PyQt6.QtGui import QIcon
    app.setWindowIcon(QIcon.fromTheme("classifier"))
    w = Win()
    w.show()
    if shots:
        out = Path(shots)
        out.mkdir(parents=True, exist_ok=True)

        def take():
            w.update_status()
            w.grab().save(str(out / "0-window.png"))
            r = Review(w)
            r.show()
            for i in range(r.tabs.count()):
                r.tabs.setCurrentIndex(i)
                app.processEvents()
                r.grab().save(str(out / f"1-review-{i}.png"))
            h = w.help_dialog(); h.show(); app.processEvents()
            h.grab().save(str(out / "2-help.png"))
            a = w.about_box(); a.show(); app.processEvents()
            a.grab().save(str(out / "3-about.png"))
            d = AllowDialog(w); d.show(); app.processEvents()
            d.grab().save(str(out / "4-allow.png"))
            app.quit()
        QTimer.singleShot(300, take)
    return app.exec()


def validate(args):
    """The checks that need no Docker, first: a refused folder, a bad --write
    or a changed policy must not wait behind (or trigger) the Docker password
    prompt."""
    ws = resolve_workspace(args.workspace)
    resolve_writes(ws, args.write)
    for flag in ("prompt_file", "brief_file", "settings_file"):
        v = getattr(args, flag)
        if v and not Path(v).expanduser().is_file():
            raise Refused(f"no such file for --{flag.replace('_', '-')}: {v}")
    for h in args.allow_host or []:
        if not HOST_RE.match(h.lower()):
            raise Refused(f"--allow-host {h}: not a host name")
    policy_check()
    pick_model(args.model)


def cmd_launch(args, resume=None) -> int:
    validate(args)
    ensure_docker()
    reap_stale()
    build_images(bool(args.upgrade))
    version_notice()
    run_id, meta = prepare(args, resume=resume)
    if args.gui:
        if not shutil.which("xterm"):
            finish_run(run_id, quiet=True)
            raise Refused("xterm is not installed on this machine (sudo apt-get install xterm).")
        me = os.path.abspath(__file__)
        quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)

        def wait_runner(proc):
            for _ in range(150):                 # the window's runner takes over
                if (RUNS / run_id / "runner.pid").exists():
                    return True
                if proc.poll() is not None:
                    return False
                time.sleep(0.1)
            return True
        menus = os.environ.get("CLAUDE_DOCKER_WINDOW", "menus") != "xterm" and has_pyqt6()
        if menus:
            wlog = CACHE / "sessions" / f"{run_id}-window.log"
            wlog.parent.mkdir(parents=True, exist_ok=True)
            with open(wlog, "w", encoding="utf-8") as fh:
                win = subprocess.Popen([sys.executable, me, "--_window", run_id],
                                       env=dict(os.environ, QT_QPA_PLATFORM="xcb"),
                                       stdin=subprocess.DEVNULL, stdout=fh, stderr=fh,
                                       start_new_session=True)
            if not wait_runner(win):
                say("claude-classifier-docker: the window with menus could not open; using a plain "
                    "terminal window instead.", err=True)
                menus = False
        if not menus:
            term = subprocess.Popen(xterm_argv(TITLE, [sys.executable, me, "--_run", run_id]),
                                    **quiet)
            if not wait_runner(term):
                finish_run(run_id, quiet=True)
                raise Refused(f"the window could not be opened (xterm exited {term.returncode}).")
        say(f"claude-classifier-docker: launched in a separate window ({TITLE}).")
        say("  - Close the window or exit Claude to end the session.")
        return 0
    return run_session(run_id)


def cmd_resume(args) -> int:
    sid = newest_session() if args.cont else (args.resume or choose_session())
    if not sid:
        raise Refused("there is no Docker session to continue.")
    reg = load_sessions()
    rid = reg["sessions"].get(sid)
    rec = reg["runs"].get(rid or "", {})
    if not rec:
        say(f"claude-classifier-docker: no launch settings were recorded for {sid[:8]}; "
            "reopening it with the defaults.")
    inputs = INPUTS / (rid or "")
    ns = argparse.Namespace(**vars(args))
    ns.workspace = args.workspace or rec.get("workspace")
    ns.write = args.write or rec.get("writes") or []
    ns.allow_host = args.allow_host or rec.get("allow_hosts") or []
    ns.model = args.model or (rec.get("model") if rec.get("model") != saved_default() else None)
    ns.brief_file = args.brief_file or (str(inputs / "brief.md") if (inputs / "brief.md").is_file() else None)
    ns.settings_file = args.settings_file or (str(inputs / "settings.json")
                                              if (inputs / "settings.json").is_file() else None)
    ns.prompt_file = None
    return cmd_launch(ns, resume=sid)


def reload_proxy(run_id) -> bool:
    """Make a running session's squid re-read its allow-list, and wait until it has.

    SIGHUP from outside (`docker kill -s HUP`): squid runs as PID 1 in its
    container, and `squid -k reconfigure` refuses to signal PID 1."""
    log = CACHE / "proxy-logs" / run_id / "cache.log"
    def ready_count():
        try:
            return log.read_text(errors="replace").count("Accepting HTTP")
        except OSError:
            return 0
    before = ready_count()
    r = docker("kill", "-s", "HUP", f"claude-classifier-docker-proxy-{run_id}")
    if r.returncode != 0:
        say(f"  could not reload the proxy of {run_id}: {r.stderr.strip()}", err=True)
        return False
    for _ in range(100):
        if ready_count() > before:
            return True
        time.sleep(0.1)
    say(f"  the proxy of {run_id} did not confirm the reload; see {log}", err=True)
    return False


def cmd_allow(host, keep, only=None) -> int:
    h = host.lower()
    if not HOST_RE.match(h):
        say(f"claude-classifier-docker: not a host name: {host}", err=True)
        return 2
    if h in ANTHROPIC_HOSTS:
        say(f"{h} is always allowed.")
        return 0
    live = []
    for run in (RUNS.iterdir() if RUNS.is_dir() else []):
        if only and run.name != only:
            continue
        try:
            pid = int((run / "runner.pid").read_text().strip())
        except (OSError, ValueError):
            continue
        if not pid_alive(pid):
            continue
        extra = run / "proxy" / "extra-hosts.txt"
        if h not in list_lines(extra):
            with open(extra, "a", encoding="utf-8") as fh:
                fh.write(h + "\n")
        hosts_file(run)
        if reload_proxy(run.name):
            live.append(run.name)
    if keep:
        if h not in [x.lower() for x in list_lines(ALLOWED_HOSTS)]:
            with open(ALLOWED_HOSTS, "a", encoding="utf-8") as fh:
                fh.write(h + "\n")
        say(f"claude-classifier-docker: {h} saved in {ALLOWED_HOSTS} for future sessions.")
    if live:
        say(f"claude-classifier-docker: {h} is allowed now in {len(live)} running session(s); "
            "no restart needed.")
    elif not keep:
        say("claude-classifier-docker: no session is running. To allow it for future sessions: "
            f"claude-classifier-docker --allow {h} --keep")
    return 0



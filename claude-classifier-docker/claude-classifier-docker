class Refused(Exception):
    """A launch refused with a reason the person must see."""


def say(msg="", err=False):
    try:
        print(msg, file=sys.stderr if err else sys.stdout, flush=True)
    except (OSError, ValueError):
        pass


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def _fit(widget, w, h):
    """Resize a window, but never beyond the screen it opens on (added by
    Classifier's make.py: a 1280x615 display could not show the whole window)."""
    try:
        from PyQt6.QtGui import QGuiApplication
        scr = QGuiApplication.primaryScreen()
        if scr is not None:
            g = scr.availableGeometry()
            w, h = min(w, g.width() - 16), min(h, g.height() - 48)
    except Exception:
        pass
    widget.resize(w, h)


def write_json(path: Path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=1) + "\n", encoding="utf-8")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def list_lines(path: Path) -> list[str]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    return [ln.strip() for ln in text.splitlines()
            if ln.strip() and not ln.strip().startswith("#")]


def docker(*args, check=False, quiet=True, **kw):
    return subprocess.run(["docker", *args], check=check, text=True,
                          stdout=subprocess.PIPE if quiet else None,
                          stderr=subprocess.PIPE if quiet else None, **kw)


def rmtree(path: Path):
    """Remove a folder; if something in it is root-owned (a mount point Docker
    created), remove that through Docker, which can."""
    shutil.rmtree(path, ignore_errors=True)
    if path.exists() and path.is_relative_to(DATA) and shutil.which("docker"):
        docker("run", "--rm", "--user", "0", "--network", "none", "--entrypoint", "rm",
               "-v", f"{path.parent}:/p", PROXY_IMAGE, "-rf", f"/p/{path.name}")


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


# ─────────────────────────────── the model ────────────────────────────────
def saved_default() -> str:
    lines = list_lines(MODEL_FILE)
    return lines[0] if lines else BUILTIN_MODEL


def resolve_model(choice: str):
    if choice.isdigit():
        n = int(choice)
        return MODELS[n - 1][0] if 1 <= n <= len(MODELS) else None
    return choice if re.match(r"^[A-Za-z][][A-Za-z0-9._:@/-]*$", choice) else None


def show_models(current: str):
    for i, (name, what) in enumerate(MODELS, 1):
        say(f"  {'*' if name == current else ' '} {i}  {name:<17} {what}")


def save_default(model: str):
    MODEL_FILE.parent.mkdir(parents=True, exist_ok=True)
    MODEL_FILE.write_text(model + "\n", encoding="utf-8")
    say(f"claude-classifier-docker: your default model is now {model} (saved in {MODEL_FILE}).")
    env = os.environ.get("ANTHROPIC_MODEL")
    if env and env != model:
        say(f"  But ANTHROPIC_MODEL={env} is set in this environment, and it")
        say("  comes first. Unset it for your default to be used.")


def pick_model(arg):
    if arg:
        m = resolve_model(arg)
        if not m:
            raise Refused("not a model name or a number from the list. "
                          "See the list with: claude-classifier-docker --models")
        return m, "--model"
    if os.environ.get("ANTHROPIC_MODEL"):
        return os.environ["ANTHROPIC_MODEL"], "ANTHROPIC_MODEL in the environment"
    if list_lines(MODEL_FILE):
        return saved_default(), "your default"
    return BUILTIN_MODEL, "built-in default; choose yours with: claude-classifier-docker --models"


def cmd_models():
    current = saved_default()
    say("Claude models for claude-classifier-docker (* = your default):")
    show_models(current)
    say("\n  Other model names that Claude Code accepts work too.")
    if not sys.stdin.isatty():
        say("  Set your default with: claude-classifier-docker --default-model NAME")
        return 0
    while True:
        try:
            choice = input(f"Choose a number or type a model name (Enter keeps {current}): ").strip()
        except EOFError:
            return 0
        if not choice:
            say(f"claude-classifier-docker: your default stays {current}.")
            return 0
        m = resolve_model(choice)
        if m:
            save_default(m)
            return 0
        say(f"  Not a number from 1 to {len(MODELS)} or a model name: {choice}")


# ───────────────────────────── docker and images ────────────────────────────
def ensure_docker():
    if docker("info").returncode == 0:
        return
    if subprocess.run(["docker-ensure"]).returncode != 0 or docker("info").returncode != 0:
        raise Refused("the Docker daemon is not running and could not be started. "
                      "Start it with: sudo systemctl start docker (WSL: sudo service docker start)")


def latest_claude_code(timeout=10):
    try:
        with urllib.request.urlopen(
                "https://registry.npmjs.org/@anthropic-ai/claude-code/latest",
                timeout=timeout) as r:
            return json.load(r).get("version") or ""
    except Exception:                                   # noqa: BLE001 - offline is fine
        return ""


def image_id(ref):
    r = docker("image", "inspect", "-f", "{{.Id}}", ref)
    return r.stdout.strip() if r.returncode == 0 else ""


def build_images(force: bool):
    """Build the Claude image and the proxy image if missing (or with --upgrade)."""
    layout = docker("image", "inspect", "-f",
                    '{{ index .Config.Labels "claude_docker_layout" }}', IMAGE).stdout.strip()
    if image_id(IMAGE) and layout != IMAGE_LAYOUT and not force:
        say(f">>> {IMAGE} was built from an older Dockerfile (before the 2026-09-28 "
            "hardening); rebuilding it.")
        force = True
    if force or not image_id(IMAGE):
        old = image_id(IMAGE)
        ver = latest_claude_code()
        if ver:
            say(f">>> Building {IMAGE} with Claude Code {ver} (a few minutes)...")
            rc = docker("build", "--build-arg", f"CLAUDE_CODE_VERSION={ver}", "-t", IMAGE,
                        str(CONF), quiet=False).returncode
        else:
            say(">>> Could not look up the newest Claude Code on npm; building without the cache...")
            rc = docker("build", "--no-cache", "-t", IMAGE, str(CONF), quiet=False).returncode
        if rc != 0:
            raise Refused(f"building {IMAGE} failed (see the output above).")
        # The replaced image holds ~2 GB on a tight C: drive. Remove it only when
        # no tag is left (a copy someone tagged to keep stays).
        new = image_id(IMAGE)
        if old and old != new:
            tags = docker("image", "inspect", "-f", "{{len .RepoTags}}", old)
            if tags.returncode == 0 and tags.stdout.strip() == "0":
                if docker("image", "rm", old).returncode == 0:
                    say(">>> Removed the previous image.")
    if force or not image_id(PROXY_IMAGE):
        say(f">>> Building {PROXY_IMAGE} (the network allow-list proxy)...")
        if docker("build", "-t", PROXY_IMAGE, str(CONF / "proxy"), quiet=False).returncode != 0:
            raise Refused(f"building {PROXY_IMAGE} failed (see the output above).")


def version_notice():
    """Once a day, say when npm has a newer Claude Code than the image."""
    cache = CACHE / "latest-version"
    cache.parent.mkdir(parents=True, exist_ok=True)
    if not cache.exists() or time.time() - cache.stat().st_mtime > 86400:
        v = latest_claude_code(3)
        cache.write_text((v + "\n") if v else "", encoding="utf-8")
    latest = (list_lines(cache) or [""])[0]
    r = docker("image", "inspect", "-f", '{{ index .Config.Labels "claude_code_version" }}', IMAGE)
    have = r.stdout.strip() if r.returncode == 0 else ""
    if have == "<no value>":
        have = ""
    if latest and have != latest:
        say(f"claude-classifier-docker: Claude Code {latest} is out; this image has {have or 'an older one'}.", err=True)
        say("  Upgrade with: claude-classifier-docker --upgrade", err=True)


# ─────────────────────────────── the policy ────────────────────────────────
def _get(d, path):
    for k in path:
        if not isinstance(d, dict) or k not in d:
            return None, False
        d = d[k]
    return d, True


def policy_loosened(data: dict) -> list[str]:
    """The safety rules this policy no longer enforces, in plain words."""
    out = []
    for path, safe, words in SAFETY:
        val, found = _get(data, path)
        if path == ("disableAutoMode",) and not (found and val == safe):
            val, found = _get(data, ("permissions", "disableAutoMode"))
        if not found or val != safe:
            out.append(f"{words} — {'.'.join(path)} is "
                       f"{json.dumps(val) if found else 'not set'} (safe: {json.dumps(safe)})")
    return out


def policy_describe(data: dict) -> list[str]:
    loose = {w.split(" — ")[0] for w in policy_loosened(data)}
    return [("  ✓ " if words not in loose else "  ✗ NOT ENFORCED: ") + words
            for _, _, words in SAFETY]


def policy_check():
    """Refuse a launch unless the policy exists, parses, and is the accepted one."""
    if not POLICY.is_file():
        raise Refused(f"the policy file is missing: {POLICY}\n"
                      "A session cannot start without it. Restore it, then run: "
                      "claude-classifier-docker --policy edit")
    try:
        data = json.loads(POLICY.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("not a JSON object")
    except ValueError as exc:
        raise Refused(f"the policy file is not valid JSON ({exc}): {POLICY}\n"
                      "Fix it with: claude-classifier-docker --policy edit") from None
    digest = sha256(POLICY)
    accepted = (list_lines(POLICY_ACCEPTED) or [""])[0]
    if not accepted:
        if policy_loosened(data):
            raise Refused("the policy loosens safety rules and has never been accepted. "
                          "Review it with: claude-classifier-docker --policy edit")
        POLICY_ACCEPTED.parent.mkdir(parents=True, exist_ok=True)
        POLICY_ACCEPTED.write_text(digest + "\n", encoding="utf-8")
    elif accepted != digest:
        raise Refused(f"the policy file changed outside `claude-classifier-docker --policy edit`: {POLICY}\n"
                      "Review the change with: claude-classifier-docker --policy edit")
    return data


def cmd_policy(action):
    if action in (None, "show"):
        data = read_json(POLICY)
        if not isinstance(data, dict):
            say(f"The policy file is missing or not valid JSON: {POLICY}")
            return 1
        say(f"claude-classifier-docker policy ({POLICY}), which no session can change:")
        for line in policy_describe(data):
            say(line)
        accepted = (list_lines(POLICY_ACCEPTED) or [""])[0]
        if accepted and accepted != sha256(POLICY):
            say("\n  The file changed since it was last accepted; launches are refused "
                "until you run: claude-classifier-docker --policy edit")
        return 0
    if action != "edit":
        say("claude-classifier-docker: --policy takes nothing (show) or 'edit'.", err=True)
        return 2
    before = read_json(POLICY, {}) or {}
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as fh:
        fh.write(POLICY.read_text(encoding="utf-8") if POLICY.is_file() else "{}\n")
        tmp = Path(fh.name)
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or (
        "nano" if shutil.which("nano") else "vi")
    try:
        while True:
            subprocess.run(shlex.split(editor) + [str(tmp)])
            try:
                data = json.loads(tmp.read_text(encoding="utf-8"))
                if not isinstance(data, dict):
                    raise ValueError("not a JSON object")
                break
            except ValueError as exc:
                say(f"That is not valid JSON ({exc}).")
                if input("Edit again? [Y/n] ").strip().lower() == "n":
                    say("Nothing changed.")
                    return 1
        newly = [w for w in policy_loosened(data) if w not in policy_loosened(before)]
        if newly:
            say("\nThis edit LOOSENS these safety rules:")
            for w in newly:
                say(f"  - {w}")
            if input("Accept the loosened policy? Type yes to accept: ").strip().lower() != "yes":
                say("Nothing changed.")
                return 1
        POLICY_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(tmp, POLICY)
        POLICY_ACCEPTED.parent.mkdir(parents=True, exist_ok=True)
        POLICY_ACCEPTED.write_text(sha256(POLICY) + "\n", encoding="utf-8")
        say("Policy saved; it applies from the next launch.")
        for line in policy_describe(data):
            say(line)
        return 0
    finally:
        tmp.unlink(missing_ok=True)


# ──────────────────────────── the launch folder ─────────────────────────────
def refused_workspace(ws: Path):
    """Why WS may not be a launch folder, or None."""
    home = HOME.resolve()
    s = str(ws)
    if ":" in s:
        return "its path contains ':', which Docker cannot mount"
    if ws == Path("/") or ws == home:
        return "it is / or your home folder"
    parts = ws.parts
    if parts[:2] == ("/", "mnt") and (len(parts) <= 3 or (
            len(parts) <= 5 and len(parts) >= 4 and parts[3].lower() == "users")):
        return "it is a whole drive or the Windows users / profile folder"
    for sensitive in (home / ".claude", home / ".ssh", home / ".config", DATA.resolve()):
        if sensitive.is_relative_to(ws):
            return f"it contains {sensitive}"
        if ws.is_relative_to(sensitive):
            return f"it is inside {sensitive}"
    return None


def resolve_workspace(arg):
    if arg:
        raw, source = arg, "given"
    elif os.environ.get("CLAUDE_CLASSIFIER_DOCKER_WORKSPACE"):
        raw, source = os.environ["CLAUDE_CLASSIFIER_DOCKER_WORKSPACE"], "CLAUDE_CLASSIFIER_DOCKER_WORKSPACE"
    else:
        lines = list_lines(DEFAULT_WS_FILE)
        if not lines:
            raise Refused(
                "no launch folder: none was given and the local folder is not set.\n"
                f"Put the folder ZIS is installed in into {DEFAULT_WS_FILE}, e.g.\n"
                f"  echo /path/to/the/zis/folder > {DEFAULT_WS_FILE}\n"
                "or name one: claude-classifier-docker DIR")
        raw, source = os.path.expanduser(os.path.expandvars(lines[0])), str(DEFAULT_WS_FILE)
    ws = Path(raw).expanduser().resolve()
    if not ws.is_dir():
        raise Refused(f"the launch folder does not exist: {raw} (from {source})")
    why = refused_workspace(ws)
    if why:
        raise Refused(f"refusing to mount {ws}: {why}.\n"
                      "Plain `claude-classifier-docker` uses the local folder; or name a narrower folder.")
    return ws


def resolve_writes(ws: Path, subs) -> list[tuple[Path, str]]:
    """(real path, path inside /workspace) for each --write; refuse escapes."""
    out = []
    for sub in subs or []:
        p = Path(sub).expanduser()
        p = p if p.is_absolute() else ws / p
        p = Path(os.path.abspath(p))
        if not p.is_relative_to(ws):
            # an absolute spelling through a symlink to the launch folder
            real = p.resolve()
            if real.is_relative_to(ws):
                p = real
            else:
                raise Refused(f"--write {sub}: it is not inside the launch folder {ws}")
        # Refuse any symlink between the launch folder and the target: Docker
        # would follow it on the host and could mount an outside folder writable.
        cur = ws
        for part in p.relative_to(ws).parts:
            cur = cur / part
            if cur.is_symlink():
                raise Refused(f"--write {sub}: {cur} is a symlink, which could lead "
                              "outside the launch folder")
        if not p.is_dir():
            raise Refused(f"--write {sub}: no such folder: {p}")
        rel = p.relative_to(ws).as_posix()
        out.append((p, "/workspace" + ("" if rel == "." else "/" + rel)))
    return out


def find_masks(ws: Path) -> list[tuple[str, bool]]:
    """(relative path, is_dir) of everything to hide in the launch folder."""
    names = [p.lower() for p in MASK_PATTERNS]
    hide = list_lines(HIDE_FILE)
    rel_paths = MASK_ROOT_PATHS + [h.strip("/") for h in hide if "/" in h.strip("/")]
    names += [h.lower() for h in hide if "/" not in h.strip("/")]
    found = {}
    for rel in rel_paths:
        p = ws / rel
        if p.exists() and not p.is_symlink():
            found[rel] = p.is_dir()
    base_depth = len(ws.parts)
    for root, dirs, files in os.walk(ws):
        r = Path(root)
        depth = len(r.parts) - base_depth
        keep = []
        for d in dirs:
            if d in SKIP_DIRS or (r / d).is_symlink():
                continue
            if any(fnmatch.fnmatchcase(d.lower(), n) for n in names):
                found[(r / d).relative_to(ws).as_posix()] = True
                continue                        # hidden whole; no need to look inside
            keep.append(d)
        dirs[:] = keep if depth + 1 < MASK_DEPTH else []
        for f in files:
            if any(fnmatch.fnmatchcase(f.lower(), n) for n in names):
                p = r / f
                if not p.is_symlink():
                    found[p.relative_to(ws).as_posix()] = False
    # a path inside an already-hidden folder needs no mount of its own
    out = sorted(found.items())
    dirs_hidden = [k for k, v in out if v]
    return [(k, v) for k, v in out
            if not any(k != d and k.startswith(d + "/") for d in dirs_hidden)
            and ":" not in k]


# ───────────────────────────── config and login ─────────────────────────────
def sanitise_claude_json(src, workspace_trust=True) -> dict:
    data = src if isinstance(src, dict) else {}
    out = {k: v for k, v in data.items() if k in CLAUDE_JSON_KEEP}
    proj = ((data.get("projects") or {}).get("/workspace") or {}) if isinstance(
        data.get("projects"), dict) else {}
    kept = {k: v for k, v in proj.items() if k in PROJECT_KEEP}
    if workspace_trust:
        kept["hasTrustDialogAccepted"] = True
    out["projects"] = {"/workspace": kept}
    out["autoUpdates"] = False
    return out


def cred_expiry(path: Path) -> int:
    d = read_json(path, {}) or {}
    try:
        return int((d.get("claudeAiOauth") or {}).get("expiresAt") or 0)
    except (TypeError, ValueError):
        return 0


# ─────────────────────────────── memory ────────────────────────────────────
def tree_hashes(root: Path) -> dict[str, str]:
    out = {}
    if root.is_dir():
        for p in sorted(root.rglob("*")):
            if p.is_file() and not p.is_symlink():
                out[p.relative_to(root).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()
    return out


def pending_sets() -> list[Path]:
    if not PENDING.is_dir():
        return []
    return sorted((p for p in PENDING.iterdir() if (p / "meta.json").is_file()),
                  key=lambda p: p.name, reverse=True)


def overlay_pending(work: Path, session_id: str) -> list[Path]:
    """Apply a session's own pending sets to a working memory copy (resume)."""
    used = []
    for s in reversed(pending_sets()):                  # oldest first
        meta = read_json(s / "meta.json", {}) or {}
        if session_id not in (meta.get("sessions") or []):
            continue
        for rel in (read_json(s / "base.json", {}) or {}):
            src = s / "files" / rel
            if src.is_file():
                (work / rel).parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(src, work / rel)
        for rel in read_json(s / "deleted.json", []) or []:
            (work / rel).unlink(missing_ok=True)
        used.append(s)
    return used


def save_pending(run: Path, meta: dict, sessions: list[str]):
    """Keep what a session changed in memory, for review; approved memory is untouched."""
    base = read_json(run / "memory-base.json", {}) or {}
    now = tree_hashes(run / "memory")
    changed = {rel: base.get(rel) for rel, h in now.items() if base.get(rel) != h}
    deleted = sorted(rel for rel in base if rel not in now)
    superseded = [PENDING / n for n in meta.get("overlaid_sets", [])]
    if not changed and not deleted:
        for s in superseded:
            shutil.rmtree(s, ignore_errors=True)
        return None
    dest = PENDING / run.name
    (dest / "files").mkdir(parents=True, exist_ok=True)
    for rel in changed:
        (dest / "files" / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(run / "memory" / rel, dest / "files" / rel)
    write_json(dest / "base.json", changed)
    write_json(dest / "deleted.json", deleted)
    write_json(dest / "meta.json", {
        "run": run.name, "created": time.strftime("%Y-%m-%d %H:%M"),
        "workspace": meta.get("workspace"), "brief": meta.get("brief_src"),
        "sessions": sessions, "resume_of": meta.get("resume_of")})
    for s in superseded:
        if s != dest:
            shutil.rmtree(s, ignore_errors=True)
    return dest


def _show_diff(old: Path | None, new: Path | None, rel: str):
    import difflib
    a = old.read_text(encoding="utf-8", errors="replace").splitlines() if old and old.is_file() else []
    b = new.read_text(encoding="utf-8", errors="replace").splitlines() if new and new.is_file() else []
    for line in difflib.unified_diff(a, b, f"approved/{rel}", f"session/{rel}", lineterm=""):
        say(line)


def cmd_memory():
    sets = pending_sets()
    if not sets:
        say("No memory changes are waiting for review.")
        return 0
    say(f"Memory changes from Docker sessions, waiting for review ({len(sets)}):")
    for i, s in enumerate(sets, 1):
        meta = read_json(s / "meta.json", {}) or {}
        n = len(read_json(s / "base.json", {}) or {}) + len(read_json(s / "deleted.json", []) or [])
        topic = ""
        m = re.search(r"/topics/([^/]+)/", meta.get("brief") or "")
        if m:
            topic = f", topic {m.group(1)}"
        say(f"  {i}. {meta.get('created', s.name)} — {n} file(s){topic}"
            f"{' (resumed session)' if meta.get('resume_of') else ''}")
    if not sys.stdin.isatty():
        say("\nRun claude-classifier-docker --memory in a terminal to review them.")
        return 0
    while True:
        choice = input("\nOpen which one? (number; Enter to stop) ").strip()
        if not choice:
            return 0
        if not choice.isdigit() or not 1 <= int(choice) <= len(sets):
            say("  Not a number from the list.")
            continue
        _review_set(sets[int(choice) - 1])
        sets = pending_sets()
        if not sets:
            say("Nothing left to review.")
            return 0


def _review_set(s: Path):
    base = read_json(s / "base.json", {}) or {}
    deleted = read_json(s / "deleted.json", []) or []
    for rel in base:
        say(f"\n=== {rel} ({'new' if base[rel] is None else 'changed'}) ===")
        _show_diff(APPROVED_MEMORY / rel, s / "files" / rel, rel)
    for rel in deleted:
        say(f"\n=== {rel} (deleted by the session) ===")
    ans = input("\n[a]pprove all, [f]ile by file, [d]iscard all, [s]kip for now? ").strip().lower()
    if ans.startswith("s") or not ans:
        return
    if ans.startswith("d"):
        shutil.rmtree(s, ignore_errors=True)
        say("Discarded; approved memory is unchanged.")
        return
    by_file = ans.startswith("f")
    for rel, base_hash in base.items():
        if by_file and input(f"Approve {rel}? [y/N] ").strip().lower() != "y":
            continue
        _apply_file(s, rel, base_hash)
    for rel in deleted:
        if by_file and input(f"Approve deleting {rel}? [y/N] ").strip().lower() != "y":
            continue
        target = APPROVED_MEMORY / rel
        if target.is_file():
            target.unlink()
    shutil.rmtree(s, ignore_errors=True)
    say("Done; the next session loads the approved memory.")


def _apply_file(s: Path, rel: str, base_hash):
    target = APPROVED_MEMORY / rel
    now_hash = hashlib.sha256(target.read_bytes()).hexdigest() if target.is_file() else None
    if now_hash != base_hash:
        say(f"\n{rel} changed in approved memory since this session started "
            "(another review approved a change). Both versions:")
        _show_diff(target, s / "files" / rel, rel)
        ans = input("[k]eep the approved one, [t]ake the session's? ").strip().lower()
        if not ans.startswith("t"):
            return
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(s / "files" / rel, target)


# ─────────────────────────────── sessions ──────────────────────────────────
def load_sessions() -> dict:
    d = read_json(SESSIONS, {}) or {}
    d.setdefault("runs", {})
    d.setdefault("sessions", {})
    return d


def transcripts_since(t0: float) -> list[str]:
    if not HOST_PROJECTS.is_dir():
        return []
    return [p.stem for p in sorted(HOST_PROJECTS.glob("*.jsonl"), key=lambda p: p.stat().st_mtime)
            if p.stat().st_mtime >= t0 - 1]


def newest_session():
    files = sorted(HOST_PROJECTS.glob("*.jsonl"), key=lambda p: p.stat().st_mtime) \
        if HOST_PROJECTS.is_dir() else []
    return files[-1].stem if files else None


def choose_session():
    files = sorted(HOST_PROJECTS.glob("*.jsonl"), key=lambda p: p.stat().st_mtime,
                   reverse=True)[:15] if HOST_PROJECTS.is_dir() else []
    if not files:
        raise Refused("there are no Docker sessions to resume.")
    reg = load_sessions()
    say("Recent Docker sessions:")
    for i, p in enumerate(files, 1):
        run = reg["runs"].get(reg["sessions"].get(p.stem, ""), {})
        m = re.search(r"/topics/([^/]+)/", run.get("brief_src") or "")
        what = f"topic {m.group(1)}" if m else (run.get("workspace") or "")
        say(f"  {i}. {time.strftime('%Y-%m-%d %H:%M', time.localtime(p.stat().st_mtime))}"
            f"  {p.stem[:8]}  {what}")
    if not sys.stdin.isatty():
        raise Refused("name one: claude-classifier-docker --resume ID")
    c = input("Resume which one? (number) ").strip()
    if not c.isdigit() or not 1 <= int(c) <= len(files):
        raise Refused("no session chosen.")
    return files[int(c) - 1].stem


# ─────────────────────────────── the launch ────────────────────────────────
def reap_stale():
    """Remove containers, networks and run folders whose session has ended."""
    RUNS.mkdir(parents=True, exist_ok=True)
    for run in RUNS.iterdir():
        pid = 0
        try:
            pid = int((run / "runner.pid").read_text().strip())
        except (OSError, ValueError):
            pass
        started = (run / "meta.json").is_file()
        # a run folder younger than a minute with no runner yet is being launched
        young = time.time() - run.stat().st_mtime < 60
        if (pid and pid_alive(pid)) or (not pid and young):
            continue
        if started:
            finish_run(run.name, quiet=True)
        else:
            rmtree(run)
    r = docker("ps", "-a", "--filter", f"label={LABEL}", "--format",
               "{{.Names}}\t{{.Label \"" + LABEL + "\"}}")
    for line in (r.stdout or "").splitlines():
        name, _, rid = line.partition("\t")
        if rid and not (RUNS / rid).exists():
            docker("rm", "-f", name)
    r = docker("network", "ls", "--filter", f"label={LABEL}", "--format",
               "{{.Name}}\t{{.Label \"" + LABEL + "\"}}")
    for line in (r.stdout or "").splitlines():
        name, _, rid = line.partition("\t")
        if rid and not (RUNS / rid).exists():
            docker("network", "rm", name)


def hosts_file(run: Path) -> Path:
    """Rebuild the proxy's combined allow-list for this run."""
    hosts = []
    for h in ANTHROPIC_HOSTS + list_lines(ALLOWED_HOSTS) + list_lines(run / "proxy" / "extra-hosts.txt"):
        h = h.lower()
        if HOST_RE.match(h) and h not in hosts:
            hosts.append(h)
    f = run / "proxy" / "hosts" / "hosts.txt"
    f.parent.mkdir(parents=True, exist_ok=True)
    tmp = f.with_name("hosts.txt.tmp")
    tmp.write_text("\n".join(hosts) + "\n", encoding="utf-8")
    os.replace(tmp, f)
    return f


def system_note(writes, prompt_mode) -> str:
    w = ", ".join(inner for _, inner in writes) or "none"
    return (
        "## This session runs in claude-classifier-docker (a locked-down container)\n\n"
        "- Network access goes through an allow-list proxy: only Anthropic and hosts "
        "the person approved are reachable. If a web fetch or command fails with "
        "HTTP 403, \"CONNECT tunnel failed\" or \"Forbidden\", tell the person which "
        "host was refused and that they can allow it ON THEIR MACHINE (not from here) "
        "with `claude-classifier-docker --allow HOST` (this session) or `claude-classifier-docker --allow "
        "HOST --keep` (future sessions too). Retry once they say it is done. Do not "
        "look for another way out.\n"
        f"- /workspace is read-only. Writable: {w}. Some credential-looking files "
        "appear empty on purpose.\n"
        "- What you write to memory is held for the person's review; later sessions "
        "see it only once they approve it.\n")


def prepare(args, *, resume=None, command=None, tty=True) -> tuple[str, dict]:
    """Everything before the container starts. Returns (run id, meta)."""
    ws = resolve_workspace(args.workspace)
    writes = resolve_writes(ws, args.write)
    extra_hosts = []
    for h in args.allow_host or []:
        if not HOST_RE.match(h.lower()):
            raise Refused(f"--allow-host {h}: not a host name")
        extra_hosts.append(h.lower())
    inputs = {}
    for flag, key in (("prompt_file", "prompt"), ("brief_file", "brief"),
                      ("settings_file", "settings")):
        v = getattr(args, flag)
        if v:
            p = Path(v).expanduser()
            if not p.is_file():
                raise Refused(f"no such file for --{flag.replace('_', '-')}: {v}")
            inputs[key] = p.resolve()
    if "settings" in inputs and read_json(inputs["settings"]) is None:
        raise Refused(f"--settings-file is not valid JSON: {inputs['settings']}")
    policy_check()
    model, model_from = pick_model(args.model)

    run_id = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
    run = RUNS / run_id
    for d in ("config", "in", "proxy/hosts", "memory", "emptydir"):
        (run / d).mkdir(parents=True, exist_ok=True)
    os.chmod(run, 0o700)
    (run / "empty").write_bytes(b"")

    # the container's own login and a sanitised .claude.json; nothing else carries over
    if CREDS.is_file():
        shutil.copyfile(CREDS, run / "config" / ".credentials.json")
        os.chmod(run / "config" / ".credentials.json", 0o600)
    write_json(run / "config" / ".claude.json", sanitise_claude_json(read_json(CLAUDE_JSON)))
    # Mount points are made here, as you: a mount point Docker has to create
    # itself is created as root, and the run folder could then not be removed.
    (run / "config" / "settings.json").write_text("{}\n", encoding="utf-8")
    (run / "config" / "projects" / "-workspace").mkdir(parents=True, exist_ok=True)
    HOST_PROJECTS.mkdir(parents=True, exist_ok=True)
    APPROVED_MEMORY.mkdir(parents=True, exist_ok=True)

    # memory: a working copy of the approved memory; the base shows what changed
    shutil.copytree(APPROVED_MEMORY, run / "memory", dirs_exist_ok=True)
    write_json(run / "memory-base.json", tree_hashes(run / "memory"))
    overlaid = overlay_pending(run / "memory", resume) if resume else []

    # inputs, snapshotted read-only
    for key, p in inputs.items():
        shutil.copyfile(p, run / "in" / ("settings.json" if key == "settings" else f"{key}.md"))
    note = system_note(writes, "prompt" in inputs)
    brief_text = (run / "in" / "brief.md").read_text(encoding="utf-8") if "brief" in inputs else ""
    (run / "in" / "system-append.md").write_text(
        (brief_text + "\n\n" if brief_text else "") + note, encoding="utf-8")

    # the proxy's allow-list
    (run / "proxy" / "extra-hosts.txt").write_text(
        "".join(h + "\n" for h in extra_hosts), encoding="utf-8")
    hosts_file(run)
    logs = CACHE / "proxy-logs" / run_id
    logs.mkdir(parents=True, exist_ok=True)

    masks = find_masks(ws)
    meta = {
        "run": run_id, "workspace": str(ws), "writes": [str(p) for p, _ in writes],
        "allow_hosts": extra_hosts, "model": model, "model_from": model_from,
        "brief_src": str(inputs.get("brief", "")) or None,
        "prompt_src": str(inputs.get("prompt", "")) or None,
        "settings_src": str(inputs.get("settings", "")) or None,
        "started": time.time(), "resume_of": resume, "overlaid_sets": [s.name for s in overlaid],
        "gui": bool(args.gui), "shell": bool(args.shell), "masks": masks,
    }
    write_json(run / "meta.json", meta)

    try:
        return _start_proxy_and_args(args, run_id, run, meta, ws, writes, inputs, masks,
                                     model, model_from, extra_hosts, logs, resume, command, tty)
    except BaseException:
        finish_run(run_id, quiet=True)
        raise


def _start_proxy_and_args(args, run_id, run, meta, ws, writes, inputs, masks, model,
                          model_from, extra_hosts, logs, resume, command, tty):
    # the network: internal, and no address on the host side (isolated gateway)
    net = f"claude-classifier-docker-int-{run_id}"
    r = docker("network", "create", "--internal", "-o",
               "com.docker.network.bridge.gateway_mode_ipv4=isolated",
               "--label", f"{LABEL}={run_id}", net)
    if r.returncode != 0:
        raise Refused(f"could not create the session network: {r.stderr.strip()}")
    proxy = f"claude-classifier-docker-proxy-{run_id}"
    r = docker("run", "-d", "--rm", "--name", proxy, "--label", f"{LABEL}={run_id}",
               "--network", "bridge", "--user", "1000:1000", "--cap-drop", "ALL",
               "--security-opt", "no-new-privileges", "--read-only",
               "--tmpfs", "/tmp:size=64m,uid=1000,gid=1000", "--memory", "256m",
               "--pids-limit", "128",
               "-v", f"{SQUID_CONF}:/etc/squid-cd/squid.conf:ro",
               "-v", f"{run / 'proxy' / 'hosts'}:/etc/squid-cd/hosts:ro",
               "-v", f"{logs}:/var/log/squid-cd", PROXY_IMAGE)
    if r.returncode != 0:
        raise Refused(f"could not start the network proxy: {r.stderr.strip()}")
    r = docker("network", "connect", net, proxy)
    if r.returncode != 0:
        raise Refused(f"could not attach the proxy to the session network: {r.stderr.strip()}")
    ip = docker("inspect", "-f", "{{(index .NetworkSettings.Networks \"" + net + "\").IPAddress}}",
                proxy).stdout.strip()
    if not ip:
        raise Refused("could not find the proxy's address on the session network.")
    for _ in range(100):                              # squid is up when it says so
        try:
            if "Accepting HTTP" in (logs / "cache.log").read_text(errors="replace"):
                break
        except OSError:
            pass
        if docker("inspect", "-f", "{{.State.Running}}", proxy).stdout.strip() != "true":
            raise Refused("the network proxy stopped while starting; see "
                          f"{logs / 'cache.log'}")
        time.sleep(0.1)
    else:
        raise Refused(f"the network proxy did not start; see {logs / 'cache.log'}")

    purl = f"http://{ip}:3128"
    dargs = ["run", "--rm", "--name", f"claude-classifier-docker-{run_id}", "--label", f"{LABEL}={run_id}",
             "--network", net, "--init", "--read-only",
             "--tmpfs", "/tmp:size=1g,mode=1777",
             "--tmpfs", "/home/node:size=512m,uid=1000,gid=1000,mode=0700",
             "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
             "--shm-size", "64m", "--pids-limit", "512", "--memory", "4g",
             "-e", f"HTTPS_PROXY={purl}", "-e", f"https_proxy={purl}",
             "-e", f"HTTP_PROXY={purl}", "-e", f"http_proxy={purl}",
             "-e", "NO_PROXY=", "-e", "no_proxy=",
             "-e", f"ANTHROPIC_MODEL={model}", "-e", "LANG=C.UTF-8", "-e", "LC_ALL=C.UTF-8",
             # Claude Code's own background calls, off: the official plugin
             # marketplace clone (github.com) and update checks. Then a github.com
             # refusal always means the session itself tried to reach GitHub.
             "-e", "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1",
             "-e", "DISABLE_UPDATES=1",
             "-v", f"{run / 'config'}:/home/node/.claude",
             "-v", f"{CONTAINER_SETTINGS}:/home/node/.claude/settings.json:ro",
             "-v", f"{HOST_PROJECTS}:/home/node/.claude/projects/-workspace",
             "-v", f"{run / 'memory'}:/home/node/.claude/projects/-workspace/memory",
             "-v", f"{POLICY_DIR}:/etc/claude-code:ro",
             "-v", f"{run / 'in'}:/opt/claude-docker/in:ro",
             "-v", f"{ws}:/workspace:ro"]
    if tty:
        dargs[1:1] = ["-it"]
    else:
        dargs[1:1] = ["-i"]
    if os.environ.get("ANTHROPIC_API_KEY"):
        dargs += ["-e", "ANTHROPIC_API_KEY"]
    for real, inner in writes:
        dargs += ["-v", f"{real}:{inner}"]
    for rel, is_dir in masks:
        dargs += ["-v", f"{run / ('emptydir' if is_dir else 'empty')}:/workspace/{rel}:ro"]
    dargs.append(IMAGE)

    if command:
        inner = command
    elif args.shell:
        inner = ["bash"]
    else:
        inner = ["claude", "--append-system-prompt-file", "/opt/claude-docker/in/system-append.md"]
        if "settings" in inputs:
            inner += ["--settings", "/opt/claude-docker/in/settings.json"]
        if resume:
            inner += ["--resume", resume]
        elif "brief" in inputs:
            inner.append(
                "Please start. Your instructions for this session were given to you "
                "separately, so they are not shown in this window; they are in "
                "/opt/claude-docker/in/brief.md. In your first message, tell me in one "
                "line that I can ask to see them, in full or as a summary. If I do, put "
                "them in your reply itself: a file you only read is not shown to me here.")
        elif "prompt" in inputs:
            inner.append((run / "in" / "prompt.md").read_text(encoding="utf-8"))
    dargs += inner
    write_json(run / "docker-args.json", dargs)

    say(f"claude-classifier-docker: model {model} ({model_from})")
    wtxt = ", ".join(i.replace("/workspace", ".", 1) if i != "/workspace" else "all"
                     for _, i in writes)
    say(f"claude-classifier-docker: workspace {ws} (read-only{'; writable: ' + wtxt if wtxt else ''})")
    if masks:
        say("claude-classifier-docker: hidden from Claude: " + ", ".join(m for m, _ in masks))
    if extra_hosts:
        say("claude-classifier-docker: also allowed for this launch: " + ", ".join(extra_hosts))
    n = len(pending_sets())
    if n:
        say(f"claude-classifier-docker: {n} session(s)' memory changes await review: claude-classifier-docker --memory")
    last = CACHE / "last-refused.txt"
    if last.is_file() and last.read_text().strip():
        say("claude-classifier-docker: the last session was refused these hosts: "
            + last.read_text().strip().replace("\n", ", ")
            + " (allow one with: claude-classifier-docker --allow HOST --keep)")
        last.unlink()
    return run_id, meta


def refused_hosts(run_id) -> list[str]:
    out = []
    try:
        for line in (CACHE / "proxy-logs" / run_id / "access.log").read_text(errors="replace").splitlines():
            if "TCP_DENIED" in line:
                target = line.split()[-1]
                host = target.rsplit(":", 1)[0] if ":" in target else target
                if host not in out:
                    out.append(host)
    except OSError:
        pass
    return out


def finish_run(run_id, quiet=False):
    """Stop the containers, keep the login and memory changes, remove the run folder."""
    run = RUNS / run_id
    docker("rm", "-f", f"claude-classifier-docker-{run_id}", f"claude-classifier-docker-proxy-{run_id}")
    docker("network", "rm", f"claude-classifier-docker-int-{run_id}")
    meta = read_json(run / "meta.json", {}) or {}
    cf = run / "config" / ".credentials.json"
    if cf.is_file() and read_json(cf) is not None and cred_expiry(cf) >= cred_expiry(CREDS):
        DATA.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(cf, CREDS)
        os.chmod(CREDS, 0o600)
    cj = read_json(run / "config" / ".claude.json")
    if isinstance(cj, dict):
        write_json(CLAUDE_JSON, sanitise_claude_json(cj))
    sessions = transcripts_since(meta.get("started", time.time())) if meta else []
    if meta.get("resume_of") and meta["resume_of"] not in sessions:
        sessions.append(meta["resume_of"])
    pend = save_pending(run, meta, sessions) if (run / "memory").is_dir() else None
    if meta and not meta.get("selftest"):
        reg = load_sessions()
        reg["runs"][run_id] = {k: meta.get(k) for k in (
            "workspace", "writes", "allow_hosts", "model", "brief_src", "prompt_src",
            "settings_src", "gui", "shell")}
        for sid in sessions:
            reg["sessions"][sid] = run_id
        write_json(SESSIONS, reg)
        if (run / "in").is_dir() and sessions:
            dest = INPUTS / run_id
            shutil.copytree(run / "in", dest, dirs_exist_ok=True)
    refused = [h for h in refused_hosts(run_id) if h not in CLAUDE_BACKGROUND_HOSTS]
    if refused and not meta.get("selftest"):
        (CACHE / "last-refused.txt").write_text("\n".join(refused) + "\n", encoding="utf-8")
    rmtree(run)
    if not quiet:
        if refused:
            say("claude-classifier-docker: this session was refused: " + ", ".join(refused))
            say("  allow one for good with: claude-classifier-docker --allow HOST --keep")
        if pend:
            say("claude-classifier-docker: this session changed memory; review with: claude-classifier-docker --memory")


def run_session(run_id) -> int:
    """Run the container in this terminal and clean up however it ends."""
    run = RUNS / run_id
    (run / "runner.pid").write_text(f"{os.getpid()}\n")
    dargs = read_json(run / "docker-args.json")
    meta = read_json(run / "meta.json", {}) or {}
    log = CACHE / "sessions" / f"{run_id}.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    proc = None
    hung_up = threading.Event()

    def on_hup(signum, frame):
        hung_up.set()
        # the window is gone: nothing can be printed any more
        try:
            fd = os.open(str(log), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            os.dup2(fd, 1)
            os.dup2(fd, 2)
        except OSError:
            pass
        if proc and proc.poll() is None:
            proc.terminate()

    signal.signal(signal.SIGHUP, on_hup)
    signal.signal(signal.SIGTERM, on_hup)
    signal.signal(signal.SIGINT, signal.SIG_IGN)       # Ctrl+C belongs to Claude
    rc = 1
    try:
        # Create, then start attached, rather than `docker run`: the create step
        # is where Docker prints its warnings (on WSL, "Your kernel does not
        # support swap limit capabilities…" for the 4 GB memory cap, which still
        # applies). They go to the session log instead of the top of the window.
        name = dargs[dargs.index("--name") + 1]
        made = subprocess.run(["docker", "create", *dargs[1:]], text=True,
                              capture_output=True)
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(made.stderr)
        if made.returncode != 0:
            say(f"claude-classifier-docker: the session could not start:\n{made.stderr.strip()}", err=True)
            rc = made.returncode
        else:
            proc = subprocess.Popen(["docker", "start", "--attach", "--interactive", name])
            rc = proc.wait()
    finally:
        finish_run(run_id, quiet=hung_up.is_set())
    if meta.get("gui") and not hung_up.is_set() and rc not in (0, 130):
        try:
            input(f"\nclaude-classifier-docker: the session ended with an error ({rc}). Press Enter to close. ")
        except (EOFError, OSError):
            pass
    return rc


